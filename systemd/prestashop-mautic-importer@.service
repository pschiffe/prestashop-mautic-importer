[Unit]
Description=PrestaShop to Mautic subscriber import (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
LoadCredential=config.json:/etc/prestashop-mautic-importer/%i.json
ExecStart=/usr/bin/php /usr/local/bin/prestashop-mautic-importer --config %d/config.json
TimeoutStartSec=45min
UMask=0077
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
